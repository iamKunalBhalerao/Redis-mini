{
  "name": "notify-pub-sub",
  "version": "1.0.0",
  "description": "notify pub sub",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "subscriber": "tsx src/subscriber.ts",
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "notify",
    "pub",
    "sub",
    "redis"
  ],
  "author": "kunalBhalerao",
  "license": "MIT",
  "dependencies": {
    "@repo/config": "workspace:*",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.15.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
